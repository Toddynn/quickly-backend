		"@types/express": "^5.0.6",
		"@types/express-session": "^1.19.0",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.2.0",
		"@types/node": "^22.20.1",
