		"date-fns": "^4.4.0",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-session": "^1.19.0",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.2.0",
		"nodemailer": "^9.0.5",
